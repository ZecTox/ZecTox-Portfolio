{
  "name": "zectox-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node generate-sitemap.js",
    "sync:blog-shells": "node scripts/sync-blog-shells.mjs",
    "sync:blog-seo": "node scripts/normalize-blog-seo.mjs",
    "sync:blog-related": "node scripts/inject-related-reading.mjs",
    "sync:components": "node scripts/sync-components.mjs",
    "build": "vite build && node scripts/hash-assets.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:icons": "node scripts/subset-icons.mjs",
    "validate": "node scripts/validate-build.mjs",
    "check": "npm run lint && npm run build && npm run validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.9.1",
    "globals": "^15.9.0",
    "sharp": "^0.34.5",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.2.4"
  },
  "description": "Portfolio and technical blog of Tejas Kedare, Shopify developer and consultant."
}
